# Copy to apps/api/.env for local development. Never commit .env files.

# development | preview | staging | production
CAVI_ENV=development

CAVI_HTTP_ADDR=:8080

# Matches infrastructure/docker/docker-compose.yml (local only).
CAVI_DATABASE_URL=postgres://cavi:cavi_local_dev@localhost:5432/cavi?sslmode=disable

# Comma-separated list of frontend origins allowed to call the API with credentials.
CAVI_ALLOWED_ORIGINS=http://localhost:3000

# How long to wait for in-flight requests on shutdown.
CAVI_SHUTDOWN_TIMEOUT=15s

# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted for the
# client IP (used by rate limiting). Leave empty when clients connect directly.
CAVI_TRUSTED_PROXIES=

# Externally reachable API base URL (builds the sign-in callback URL).
# Defaults to http://localhost:8080 in development; required elsewhere (https).
CAVI_PUBLIC_API_URL=http://localhost:8080

# Frontend base URL; users land here after signing in or out.
# Defaults to http://localhost:3000 in development; required elsewhere (https).
CAVI_WEB_URL=http://localhost:3000

# WorkOS AuthKit (dashboard → API Keys). Secret: set in apps/api/.env only.
# Leave both empty to run without sign-in in development.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# Session lifetime (default 720h = 30 days, minimum 1h).
CAVI_SESSION_TTL=720h

# Object storage for media (S3-compatible). Locally this is SeaweedFS from
# infrastructure/docker (make db-up, then make storage-setup once). In
# staging/production use Cloudflare R2: the endpoint is
# https://<account-id>.r2.cloudflarestorage.com, region auto, path style false.
# Leave CAVI_STORAGE_ENDPOINT empty to run without media in development.
CAVI_STORAGE_ENDPOINT=http://localhost:8333
# How browsers reach storage, if different from the API (signed URLs use it).
CAVI_STORAGE_PUBLIC_ENDPOINT=
CAVI_STORAGE_REGION=us-east-1
CAVI_STORAGE_BUCKET=cavi-media
# Local-only credentials from infrastructure/docker/seaweedfs/s3.json.
CAVI_STORAGE_ACCESS_KEY_ID=cavi_local_access
CAVI_STORAGE_SECRET_ACCESS_KEY=cavi_local_secret_dev_only
CAVI_STORAGE_PATH_STYLE=true
