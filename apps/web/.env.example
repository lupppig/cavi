# Copy to apps/web/.env.local for local development. Never commit .env files.

# Public base URL of the CAVI Go API, used by the browser (e.g. the waitlist
# form). NEXT_PUBLIC_ values are inlined at build time, so set this per
# environment before building. The API must list this site's origin in
# CAVI_ALLOWED_ORIGINS.
NEXT_PUBLIC_CAVI_API_URL=http://localhost:8080
